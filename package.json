{
  "name": "recall-agent",
  "version": "1.0.0",
  "description": "A clean, minimal AI research chatbot with conversation memory and web search",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/memory.test.ts tests/phase3.test.ts tests/phase4.test.ts tests/phase5.test.ts",
    "evaluate": "tsx src/evaluation/cli.ts",
    "client": "npm --prefix frontend run dev",
    "build:client": "npm --prefix frontend run build"
  },
  "keywords": [
    "ai",
    "agent",
    "chatbot",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tavily/core": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
